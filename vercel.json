{
  "functions": {
    "api/room/[action].js": {
      "maxDuration": 120
    },
    "api/og.js": {
      "maxDuration": 20,
      "includeFiles": "{assets/**,node_modules/harfbuzzjs/**,node_modules/@resvg/**}"
    },
    "api/invite.js": {
      "maxDuration": 10,
      "includeFiles": "public/index.html"
    },
    "api/stream.js": {
      "maxDuration": 300
    },
    "api/cron-daily.js": {
      "maxDuration": 120
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/api/invite?room=:code"
    },
    {
      "source": "/c/:id",
      "destination": "/api/invite?challenge=:id"
    },
    {
      "source": "/daily",
      "destination": "/api/invite?daily=1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 17 * * *"
    }
  ]
}
